# Copie este arquivo para .env e preencha com valores reais.
# NUNCA versione o .env — apenas este .env.example.

# Gere uma chave nova com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cole-aqui-uma-chave-gerada

# True apenas em desenvolvimento. Em producao, use False.
DEBUG=True

# Hosts separados por virgula. Inclua o nome do servico usado dentro do Docker.
ALLOWED_HOSTS=localhost,127.0.0.1,backend
